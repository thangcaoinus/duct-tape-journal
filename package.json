{
  "name": "duct-tape-diary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "dev:host": "vite --host 0.0.0.0",
    "server": "node server/index.js",
    "server:demo": "cross-env DIARY_DIR=diary.demo node server/index.js",
    "start": "concurrently -n server,web -c blue,green \"npm:server\" \"npm:dev\"",
    "start:host": "concurrently -n server,web -c blue,green \"npm:server\" \"npm:dev:host\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "node scripts/seed.mjs",
    "demo": "npm run seed:demo && concurrently -n server,web -c blue,green \"npm:server:demo\" \"npm:dev\"",
    "demo:clean": "node -e \"require('fs').rmSync('diary.demo',{recursive:true,force:true});console.log('✓ removed diary.demo/')\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tiptap/extension-image": "^2.6.6",
    "@tiptap/extension-mathematics": "^2.6.6",
    "@tiptap/pm": "^2.6.6",
    "@tiptap/react": "^2.6.6",
    "@tiptap/starter-kit": "^2.6.6",
    "express": "^4.19.2",
    "katex": "^0.16.11",
    "pm2": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
